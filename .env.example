# Copie para .env: cp .env.example .env
# Valores abaixo são exclusivamente de desenvolvimento local.

# --- Postgres ---
# Porta do host (mude se já houver um Postgres local em 5432; ajuste DATABASE_URL junto).
POSTGRES_PORT=5432
DATABASE_URL=postgres://casebook:casebook@localhost:5432/casebook

# --- Redis (db 0 = filas BullMQ, db 1 = cache/rate-limit) ---
REDIS_URL=redis://localhost:6379

# --- Storage S3-compatível (MinIO em dev, R2 em prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=casebook
S3_SECRET_KEY=casebook-dev-secret
S3_BUCKET_ORIGINALS=casebook-originals
S3_BUCKET_MEDIA=casebook-media
S3_FORCE_PATH_STYLE=true
PUBLIC_MEDIA_URL=http://localhost:9000/casebook-media

# --- Observabilidade (OTLP HTTP para o collector do SigNoz) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Definido por processo (api, worker-image, worker-video); deixe vazio aqui.
OTEL_SERVICE_NAME=
# Admin da UI do SigNoz, criado automaticamente pelo serviço signoz-init.
SIGNOZ_ADMIN_EMAIL=dev@casebook.local
SIGNOZ_ADMIN_PASSWORD=Casebook-dev-123!

# --- API / Web ---
# URL da API vista pelo servidor Next (RSC).
API_URL=http://localhost:3001
API_PORT=3001
WEB_URL=http://localhost:3000
# URL pública do site: base dos endereços de perfil (<base>/<handle>) que as telas
# mostram. Em produção, https://casebook.com.br.
PUBLIC_BASE_URL=http://localhost:3000
# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-dev-only
# `true` só atrás de um proxy confiável (Caddy em produção): o IP do cliente passa
# a vir de X-Forwarded-For. Sem proxy o header é forjável e furaria o rate limit.
TRUST_PROXY=false
# Path do cookie de refresh (`cb_refresh`) como o browser o enxerga. O browser
# sempre fala com a API por /api (rewrite do Next em dev, Caddy em produção).
# Para curl direto na porta 3001, ver o override em docs/api/sprint-1.http.
AUTH_COOKIE_PATH=/api/auth
# Cookies de sessão com `Secure`. Só troque para false em dev se o seu browser
# recusar cookie Secure em http://localhost (Safari); nunca em produção.
AUTH_COOKIE_SECURE=true
