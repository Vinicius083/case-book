{
  "name": "@casebook/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "turbo run build --filter=@casebook/api^... --output-logs=errors-only && exec tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/instrumentation.js dist/main.js\"",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@casebook/contracts": "workspace:*",
    "@casebook/db": "workspace:*",
    "@fastify/otel": "0.21.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.1",
    "import-in-the-middle": "3.5.1",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@casebook/config": "workspace:*",
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "tsc-watch": "7.2.1",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
