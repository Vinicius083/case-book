{
  "name": "@casebook/worker-image",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "turbo run build --filter=@casebook/worker-image^... --output-logs=errors-only && exec tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/instrumentation.js dist/main.js\"",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/main.js",
    "enqueue:test": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env --enable-source-maps dist/scripts/enqueue-test.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@casebook/contracts": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "bullmq": "6.3.8",
    "ioredis": "6.0.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@casebook/config": "workspace:*",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "tsc-watch": "7.2.1",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
