{
  "name": "@casebook/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "node --env-file-if-exists=../../.env ./node_modules/next/dist/bin/next dev --port 3000",
    "start": "node --env-file-if-exists=../../.env ./node_modules/next/dist/bin/next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@casebook/contracts": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
