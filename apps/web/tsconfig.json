{
  "extends": "@casebook/config/tsconfig.nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "*.ts",
    ".next/types/**/*.ts",
    "e2e",
    "next-env.d.ts",
    "src",
    ".next-e2e/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".next-e2e"]
}
