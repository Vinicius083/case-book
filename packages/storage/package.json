    "@opentelemetry/core": "2.11.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@casebook/config": "workspace:*",
    "@types/node": "22.20.4",
    "eslint": "10.12.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
